rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Função auxiliar para verificar se o usuário está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Função auxiliar para verificar se o usuário é Administrador
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'maxwellferreira@proton.me' ||
        (request.auth.token.keys().hasAny(['admin']) && request.auth.token.admin == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin'
        ))
      );
    }

    // Função auxiliar para verificar se o usuário está aprovado para acesso
    function isApprovedUser() {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'aprovado'
        ))
      );
    }

    // Coleção de usuários do sistema (/users/{userId})
    match /users/{userId} {
      // Leitura: o próprio usuário pode ler seus dados ou o Administrador pode ler todos
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());

      // Criação: o próprio usuário autenticado ao se cadastrar
      // Novos usuários comuns são OBRIGADOS a ter status 'pending' e role 'user', sem campos de aprovação prévia
      allow create: if isAuthenticated() && request.auth.uid == userId && (
        isAdmin() ||
        (
          (request.resource.data.status == 'pending' || request.resource.data.status == 'pendente') &&
          (request.resource.data.role == 'user' || request.resource.data.role == 'farmaceutico') &&
          (!('approvedAt' in request.resource.data) || request.resource.data.approvedAt == null) &&
          (!('approvedBy' in request.resource.data) || request.resource.data.approvedBy == null) &&
          (!('rejectedAt' in request.resource.data) || request.resource.data.rejectedAt == null) &&
          (!('rejectedBy' in request.resource.data) || request.resource.data.rejectedBy == null) &&
          (!('blockedAt' in request.resource.data) || request.resource.data.blockedAt == null) &&
          (!('blockedBy' in request.resource.data) || request.resource.data.blockedBy == null)
        )
      );

      // Atualização:
      // Administrador pode alterar qualquer campo (aprovar, rejeitar, bloquear, mudar role, etc.)
      // Usuário comum pode atualizar apenas dados de perfil (nome, drogaria), SEM alterar role, status ou campos administrativos
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.role == resource.data.role &&
          (!('approvedAt' in request.resource.data) || request.resource.data.approvedAt == resource.data.approvedAt) &&
          (!('approvedBy' in request.resource.data) || request.resource.data.approvedBy == resource.data.approvedBy) &&
          (!('rejectedAt' in request.resource.data) || request.resource.data.rejectedAt == resource.data.rejectedAt) &&
          (!('rejectedBy' in request.resource.data) || request.resource.data.rejectedBy == resource.data.rejectedBy) &&
          (!('blockedAt' in request.resource.data) || request.resource.data.blockedAt == resource.data.blockedAt) &&
          (!('blockedBy' in request.resource.data) || request.resource.data.blockedBy == resource.data.blockedBy)
        )
      );

      // Exclusão: Somente Administradores podem excluir usuários
      allow delete: if isAdmin();
    }

    // Demais coleções protegidas da aplicação (prontuários, mensagens, históricos, logs, etc.)
    // Usuários com status 'pending', 'rejected' ou 'blocked' NÃO possuem acesso
    match /{document=**} {
      allow read, write: if isAuthenticated() && isApprovedUser();
    }
  }
}
